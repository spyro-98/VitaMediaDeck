/* Localizable loading-screen strings. Format:
 * VT_STR(KEY_NAME, "Italian text", "English text"). Keep printf specifiers
 * in the same order in both columns. */
VT_STR(LOADING_DEFAULT_MESSAGE, "Caricamento...", "Loading...")
VT_STR(LOADING_CANCEL_HINT, "CERCHIO per annullare", "CIRCLE to cancel")
VT_STR(LOADING_DEFAULT_TITLE, "Video", "Video")
VT_STR(LOADING_DEFAULT_STATUS, "Caricamento...", "Loading...")
VT_STR(LOADING_QUALITY_LABEL, "%dp", "%dp")
VT_STR(LOADING_QUALITY_AUTO, "AUTO", "AUTO")
VT_STR(LOADING_PROGRESS_PERCENT, "%d%%", "%d%%")
VT_STR(LOADING_DOWNLOAD_PERCENT, "Buffer %d%%", "Buffered %d%%")
VT_STR(LOADING_PLAYER_CANCEL_HINT, "CERCHIO  |  tieni premuto per tornare", "CIRCLE  |  hold to go back")
VT_STR(LOADING_DEFAULT_ERROR_MESSAGE, "Operazione non riuscita", "Operation failed")
