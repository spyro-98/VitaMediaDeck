VT_STR(IPTV_OPEN_LIST, "Apri lista canali", "Open channel list")
VT_STR(IPTV_ADD_HINT, "Formato rilevato dal link. R1 per salvare o gestire i link.", "Format detected from the link. R1 to save or manage links.")
VT_STR(IPTV_STAR_LIST, "Preferisci questa lista", "Star this playlist")
VT_STR(IPTV_NO_SAVED, "La tua TV, in un unico posto.", "Your TV, in one place.")
VT_STR(IPTV_NO_SAVED_HINT, "Aggiungi una lista M3U o un link. R1 per scansionare un QR.", "Add an M3U playlist or stream link. Open R1 to scan a QR code.")
VT_STR(IPTV_PREVIEW, "Diretta e video on demand", "Live and video on demand")
VT_STR(IPTV_LINK, "Link HTTP(S)", "HTTP(S) link")
VT_STR(IPTV_EMPTY, "Inserisci il link di un canale per iniziare.", "Enter a channel link to start watching.")
VT_STR(IPTV_PLAY, "Riproduci", "Play stream")
VT_STR(IPTV_EDIT, "Inserisci link", "Enter link")
VT_STR(IPTV_FORMATS, "HLS / DASH: video H.264 e AAC mono/stereo, fino a 720p.", "HLS / DASH: H.264 video and mono/stereo AAC, up to 720p.")
VT_STR(IPTV_LIMITS, "HLS: AES-128, tracce separate, MPEG-TS / fMP4. DRM ed EPG non disponibili.", "HLS: AES-128, separate tracks, MPEG-TS / fMP4. DRM and EPG unavailable.")
VT_STR(IPTV_EXIT_NOTE, "Pausa: la diretta si riconnette, il VOD continua dallo stesso punto.", "Pause: live reconnects; VOD resumes from the same point.")
VT_STR(IPTV_INVALID, "Usa un link HTTP(S) senza nome utente/password incorporati.", "Use an HTTP(S) link without embedded username/password.")
VT_STR(IPTV_FAILED, "Impossibile riprodurre lo stream", "Unable to play this stream")
VT_STR(IPTV_UNSUPPORTED, "Questo codec o profilo non e compatibile. Sono richiesti video H.264 e audio AAC mono/stereo.", "This codec or profile is incompatible. H.264 video and mono/stereo AAC audio are required.")
VT_STR(IPTV_NETWORK_ERROR, "Connessione fallita o scaduta. Controlla il link e riprova.", "Connection failed or timed out. Check the link and retry.")
VT_STR(IPTV_CHANGED, "La diretta è cambiata. Premi Riproduci per riconnetterti.", "The live timeline changed. Press Play to reconnect safely.")
VT_STR(IPTV_TOO_LARGE, "Lo stream supera il limite del buffer playlist o segmenti.", "The stream exceeds the bounded playlist or segment buffer.")
VT_STR(IPTV_DECODE_ERROR, "Il decoder non avvia H.264/AAC. Prova l'altro decoder nelle Impostazioni.", "Decoder could not start H.264/AAC playback. Try the other decoder in Settings.")
VT_STR(IPTV_LIVE, "Diretta / ricerca non disponibile", "Live / no seeking")
VT_STR(IPTV_PAUSED_LIVE, "In pausa / riprendi torna in diretta", "Paused / resume returns to live")
VT_STR(IPTV_GO_LIVE, "Riconnetti in diretta", "Reconnect live")
VT_STR(IPTV_PLAYER_HINT, "L1 sezioni | R1 opzioni | X pausa/live", "L1 sections | R1 options | X pause/live")
VT_STR(IPTV_FINISHED, "Stream terminato. Premi Riproduci per riconnetterti.", "Stream ended. Press Play to connect again.")
VT_STR(IPTV_VOD_HINT, "L1 sezioni | R1 opzioni | X pausa", "L1 sections | R1 options | X pause")
VT_STR(IPTV_VOD_LINEAR, "Stream / ricerca non disponibile", "Stream / no seeking")
VT_STR(IPTV_MODE_HLS, "HLS diretta / VOD", "HLS live / VOD")
VT_STR(IPTV_MODE_FILE, "File VOD (MP4/MKV)", "VOD file (MP4/MKV)")
VT_STR(IPTV_MODE_LIST, "Lista canali M3U", "M3U channel list")
VT_STR(IPTV_LIST_HINT, "X Riproduci   Quadrato Preferito   Select Preferisci lista   Cerchio Indietro", "X Play   Square Star channel   Select Star list   Circle Back")
VT_STR(IPTV_LIST_LIMIT, "Primi 512 canali della lista. Usa una lista piu piccola per gli altri.", "First 512 playlist entries. Use a smaller list for the others.")
VT_STR(IPTV_QR, "Scansiona QR", "Scan QR")
VT_STR(IPTV_SAVE, "Salva link", "Save link")
VT_STR(IPTV_COLLECTION, "Liste e canali salvati", "Saved lists / channels")
VT_STR(IPTV_NAME, "Nome del canale o della lista", "Channel or playlist name")
VT_STR(IPTV_RENAME, "Rinomina", "Rename")
VT_STR(IPTV_DELETE, "Elimina dai salvati", "Remove from saved")
VT_STR(IPTV_DELETE_TITLE, "Rimuovere il link salvato?", "Remove this saved link?")
VT_STR(IPTV_DELETE_DETAIL, "Rimuove solo questa voce. I canali salvati separatamente e i file non vengono eliminati. Puoi aggiungere di nuovo il link.", "Only this saved entry is removed. Separately saved channels and files are kept. You can add the link again.")
VT_STR(IPTV_DELETE_FAILED, "Rimozione non riuscita. La voce salvata e ancora disponibile.", "Could not remove the entry. It is still saved.")
VT_STR(IPTV_DELETED, "Link rimosso dai salvati. Nessun file eliminato.", "Removed from saved. No files were deleted.")
VT_STR(IPTV_SAVE_LIST, "Salva questa lista", "Save this playlist")
VT_STR(IPTV_MANAGE_HINT, "X Apri   Triangolo Cerca   R1 Gestisci / preferiti   Start Aggiungi", "X Open   Triangle Search   R1 Manage / favorites   Start Add")
VT_STR(IPTV_SEARCH, "Cerca liste e canali", "Search lists and channels")
VT_STR(IPTV_NO_RESULTS, "Nessun risultato per questa ricerca.", "No matching playlists or channels.")
VT_STR(IPTV_CLEAR_SEARCH, "Triangolo modifica la ricerca. Cerchio cancella il filtro.", "Triangle edits the search. Circle clears the filter.")
VT_STR(IPTV_LIST_INVALID, "Il link non contiene una lista canali M3U valida. Usa il link al file, non alla pagina web.", "This link does not contain a valid M3U channel list. Use the file link, not its web page.")
VT_STR(IPTV_REDIRECT_ERROR, "Il server non fornisce una destinazione valida. Aggiorna il link della lista.", "The server did not provide a usable redirect. Update the playlist link.")
VT_STR(IPTV_ENCRYPTED_ERROR, "La cifratura richiede una licenza DRM o una chiave non utilizzabile. AES-128 HLS e supportato.", "Encryption requires a DRM license or an unusable key. HLS AES-128 is supported.")
VT_STR(IPTV_RENDITIONS_ERROR, "Il gruppo audio/video non contiene una traccia compatibile utilizzabile.", "The audio/video group has no usable compatible rendition.")
VT_STR(IPTV_VARIANT_LIMIT_ERROR, "Nessuna qualita entro i limiti di 720p e 4 Mbps. Prova un altro stream.", "No variant fits the 720p and 4 Mbps limits. Try another stream.")
VT_STR(IPTV_NAME_INVALID, "Inserisci un nome non vuoto, su una sola riga.", "Enter a non-empty, single-line name.")
VT_STR(IPTV_DNS_ERROR, "Server non trovato (DNS). Il link potrebbe essere obsoleto; controlla lista e rete.", "Server name could not be resolved (DNS). Check for an outdated link or a network problem.")
VT_STR(IPTV_ACCESS_ERROR, "Accesso negato dal server (401/403). Il link puo essere scaduto o soggetto a restrizioni.", "Server denied access (401/403). The link may have expired or require authorized access.")
VT_STR(IPTV_NOT_FOUND_ERROR, "Stream non disponibile (404/410). Aggiorna il link nella lista.", "Stream unavailable (404/410). Update the playlist link.")
VT_STR(IPTV_TIMEOUT_ERROR, "Il server non risponde in tempo. Controlla la rete e riprova.", "The server did not respond in time. Check the network and retry.")
VT_STR(IPTV_TLS_ERROR, "Connessione sicura non verificata. Controlla data/ora e certificato del server.", "Secure connection could not be verified. Check the clock and server certificate.")
VT_STR(IPTV_SAVED, "Salvato sul dispositivo.", "Saved on this device.")
VT_STR(IPTV_SAVE_FAILED, "Salvataggio non riuscito. I dati precedenti non sono stati sostituiti.", "Could not save. Existing data has not been replaced.")
VT_STR(IPTV_SAVED_HINT, "X Apri   Quadrato Preferito   Triangolo Cerca   Cerchio Indietro", "X Open   Square Star   Triangle Search   Circle Back")
