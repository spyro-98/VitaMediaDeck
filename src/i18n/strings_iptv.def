VT_STR(IPTV_LIST_NAME, "Dai un nome alla lista", "Name your playlist")
VT_STR(IPTV_LIST_INTRO, "Importa liste o canali da un link, un QR o un file sulla console.", "Import playlists or channels from a link, QR code or file on the console.")
VT_STR(IPTV_LIST_URL_LABEL, "Link della lista o del canale", "Playlist or channel link")
VT_STR(IPTV_LIST_URL_EMPTY, "https://…", "https://…")
VT_STR(IPTV_ADD_OPEN, "Aggiungi e apri", "Add and open")
VT_STR(IPTV_OPEN_ONCE, "Apri senza salvare", "Open without saving")
VT_STR(IPTV_SAVE_PLAY, "Salva e riproduci", "Save and play")
VT_STR(IPTV_DIRECT_STREAM, "Apri stream diretto", "Open a direct stream")
VT_STR(IPTV_DIRECT_HINT, "Inserisci il link di uno stream HLS, DASH o file video.\nIl contenuto determina il formato; Select lo cambia se necessario.", "Enter an HLS, DASH or video-file link.\nThe content determines its format; Select changes it if needed.")
VT_STR(IPTV_MY_LISTS, "Torna ai salvati", "Back to saved lists")
VT_STR(IPTV_LIST_ADDED, "Lista aggiunta. Scegli un canale per riprodurlo.", "Playlist added. Select a channel to play it.")
VT_STR(IPTV_LIST_FAILED, "Impossibile aprire la lista", "Could not open this playlist")
VT_STR(IPTV_EMPTY_LIST, "La lista non contiene canali. Controlla che il link punti al file M3U corretto.", "The playlist has no channels. Check that the link points to the correct M3U file.")
VT_STR(IPTV_NAVIGATION_HINT, "Frecce: scegli   \uE000: apri   \uE002: preferito   \uE001: indietro", "D-pad: choose   \uE000: open   \uE002: favourite   \uE001: back")
VT_STR(IPTV_RENAME, "Rinomina", "Rename")
VT_STR(IPTV_DELETE, "Elimina dai salvati", "Remove from saved")
VT_STR(IPTV_DELETE_TITLE, "Rimuovere il link salvato?", "Remove this saved link?")
VT_STR(IPTV_DELETE_DETAIL, "Rimuove solo questa voce. I canali salvati separatamente e i file non vengono eliminati. Puoi aggiungere di nuovo il link.", "Only this saved entry is removed. Separately saved channels and files are kept. You can add the link again.")
VT_STR(IPTV_DELETE_FAILED, "Rimozione non riuscita. La voce salvata e ancora disponibile.", "Could not remove the entry. It is still saved.")
VT_STR(IPTV_DELETED, "Link rimosso dai salvati. Nessun file eliminato.", "Removed from saved. No files were deleted.")
VT_STR(IPTV_SAVE_LIST, "Salva questa lista", "Save this playlist")
VT_STR(IPTV_MANAGE_HINT, "↑ Azioni   \uE002 Preferito   \uE003 Cerca   Start Aggiungi", "↑ Actions   \uE002 Favourite   \uE003 Search   Start Add")
VT_STR(IPTV_SEARCH, "Cerca liste e canali", "Search lists and channels")
VT_STR(IPTV_NO_RESULTS, "Nessun risultato per questa ricerca.", "No matching playlists or channels.")
VT_STR(IPTV_CLEAR_SEARCH, "\uE003 modifica la ricerca. \uE001 torna indietro.", "\uE003 edits the search. \uE001 goes back.")
VT_STR(IPTV_LIST_INVALID, "Il link non contiene una lista canali M3U valida. Usa il link al file, non alla pagina web.", "This link does not contain a valid M3U channel list. Use the file link, not its web page.")
VT_STR(IPTV_REDIRECT_ERROR, "Il server non fornisce una destinazione valida. Aggiorna il link della lista.", "The server did not provide a usable redirect. Update the playlist link.")
VT_STR(IPTV_ENCRYPTED_ERROR, "La cifratura richiede una licenza DRM o una chiave non utilizzabile. AES-128 HLS e supportato.", "Encryption requires a DRM license or an unusable key. HLS AES-128 is supported.")
VT_STR(IPTV_RENDITIONS_ERROR, "Il gruppo audio/video non contiene una traccia compatibile utilizzabile.", "The audio/video group has no usable compatible rendition.")
VT_STR(IPTV_VARIANT_LIMIT_ERROR, "Nessuna variante compatibile con la selezione richiesta. Scegli un altro formato.", "No compatible variant matches the requested selection. Choose another format.")
VT_STR(IPTV_NAME_INVALID, "Inserisci un nome non vuoto, su una sola riga.", "Enter a non-empty, single-line name.")
VT_STR(IPTV_DNS_ERROR, "Server non trovato (DNS). Il link potrebbe essere obsoleto; controlla lista e rete.", "Server name could not be resolved (DNS). Check for an outdated link or a network problem.")
VT_STR(IPTV_ACCESS_ERROR, "Accesso negato dal server (401/403). Il link puo essere scaduto o soggetto a restrizioni.", "Server denied access (401/403). The link may have expired or require authorized access.")
VT_STR(IPTV_NOT_FOUND_ERROR, "Stream non disponibile (404/410). Aggiorna il link nella lista.", "Stream unavailable (404/410). Update the playlist link.")
VT_STR(IPTV_TIMEOUT_ERROR, "Il server non risponde in tempo. Controlla la rete e riprova.", "The server did not respond in time. Check the network and retry.")
VT_STR(IPTV_TLS_ERROR, "Connessione sicura non verificata. Controlla data/ora e certificato del server.", "Secure connection could not be verified. Check the clock and server certificate.")
VT_STR(IPTV_SAVED, "Salvato sul dispositivo.", "Saved on this device.")
VT_STR(IPTV_SAVE_FAILED, "Salvataggio non riuscito. I dati precedenti non sono stati sostituiti.", "Could not save. Existing data has not been replaced.")
VT_STR(IPTV_SAVED_HINT, "\uE000 Apri   \uE002 Preferito   \uE003 Cerca   \uE001 Indietro", "\uE000 Open   \uE002 Star   \uE003 Search   \uE001 Back")
VT_STR(IPTV_MODE_DASH, "DASH diretta / VOD", "DASH live / VOD")

VT_STR(IPTV_UNSTAR_LIST, "Rimuovi lista dai preferiti", "Remove list from favourites")

VT_STR(IPTV_MANIFEST_ERROR, "Il server non ha restituito una playlist HLS/DASH valida, oppure i dati sono incompleti. Verifica il tipo di link: lista canali, HLS, DASH o file.", "The server did not return a valid HLS/DASH playlist, or its data is incomplete. Check the link type: channel list, HLS, DASH or file.")
VT_STR(IPTV_VIDEO_CODEC_ERROR, "Nessuna traccia video H.264 utilizzabile. HEVC/H.265, AV1 e altri codec richiedono un flusso alternativo compatibile.", "No usable H.264 video track. HEVC/H.265, AV1 and other codecs require a compatible alternative stream.")
VT_STR(IPTV_AUDIO_CODEC_ERROR, "Nessuna traccia audio AAC utilizzabile. AC-3, E-AC-3 e altri codec non sono supportati in questo percorso IPTV.", "No usable AAC audio track. AC-3, E-AC-3 and other codecs are not supported in this IPTV path.")
VT_STR(IPTV_VIDEO_SIZE_ERROR, "La sorgente non dichiara dimensioni video valide, oppure il decoder non riesce ad aprirle. Prova un altro formato.", "The source has no valid video dimensions, or the decoder cannot open them. Try another format.")
VT_STR(IPTV_AUDIO_FORMAT_ERROR, "La traccia AAC non ha un formato utilizzabile. Servono audio mono/stereo, frequenza fino a 48 kHz e un profilo supportato.", "The AAC track has an unusable format. Mono/stereo audio, a rate up to 48 kHz and a supported profile are required.")
VT_STR(IPTV_SERVER_ERROR, "Errore del server IPTV (HTTP 5xx). Riprova piu tardi o usa un altro collegamento del canale.", "The IPTV server returned HTTP 5xx. Retry later or use another link for the channel.")
VT_STR(IPTV_RATE_LIMIT_ERROR, "Il server limita le richieste (HTTP 429). Attendi prima di riprovare e verifica il limite di connessioni del servizio.", "The server is limiting requests (HTTP 429). Wait before retrying and check the service connection limit.")
VT_STR(IPTV_RANGE_ERROR, "Il server non rispetta l'intervallo di byte richiesto. Questo flusso a segmenti non puo essere letto correttamente.", "The server did not honor the requested byte range. This segmented stream cannot be read correctly.")
VT_STR(IPTV_BACKGROUND_ERROR, "Impossibile avviare il caricamento in background. Chiudi la riproduzione attiva e riprova; se persiste, riavvia l'app.", "Could not start the background loader. Stop active playback and retry; restart the app if the problem persists.")

VT_STR(IPTV_CANCELLED, "Collegamento annullato.", "Connection cancelled.")
