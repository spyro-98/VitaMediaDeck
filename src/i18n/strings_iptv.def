VT_STR(IPTV_SAVED_EXPLANATION, "Salvati conserva i link dei canali. Preferiti aggiunge una stella. Nessun programma viene registrato.", "Saved channels keeps channel links. Favourites adds a star. No programmes are recorded.")

VT_STR(IPTV_CATALOG_TOO_LARGE, "La lista supera 20 MiB. Usa una lista più piccola o filtrata per paese o gruppo.", "The channel list exceeds 20 MiB. Use a smaller list or filter it by country or group.")
VT_STR(IPTV_CATALOG_LINE_TOO_LONG, "Il link o i dati di un canale sono troppo lunghi. Controlla la lista o usa una versione filtrata.", "A channel link or entry is too long. Check the playlist or use a filtered version.")
VT_STR(IPTV_MEMORY_ERROR, "Memoria insufficiente per questa qualità. Chiudi il player e prova una risoluzione più bassa.", "Not enough memory for this quality. Close the player and try a lower resolution.")
VT_STR(IPTV_RETRY_AUTOMATIC, "Prova qualità automatica", "Try automatic quality")
VT_STR(IPTV_RETRY_DEFAULT_DETAIL, "Puoi riprovare con la qualità automatica. La scelta salvata cambia solo dopo una riproduzione valida.", "You can retry with automatic quality. Your saved choice changes only after successful playback.")

