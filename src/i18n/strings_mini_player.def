/* Localizable mini-player strings. Format:
 * VT_STR(KEY_NAME, "Italian text", "English text"). Keep printf specifiers
 * in the same order in both columns. */
VT_STR(MINI_DEFAULT_TITLE, "Riproduzione VitaTube", "VitaTube playback")
VT_STR(MINI_STATE_PREPARING, "Carico audio", "Loading audio")
VT_STR(MINI_STATE_BUFFERING, "Preparo il buffer", "Preparing buffer")
VT_STR(MINI_STATE_READY, "Pronto", "Ready")
VT_STR(MINI_STATE_PAUSED, "In pausa", "Paused")
VT_STR(MINI_STATE_ERROR, "Errore audio", "Audio error")
VT_STR(MINI_STATE_PLAYING, "In riproduzione", "Playing")
VT_STR(MINI_TIMING_FORMAT, "%s / %s", "%s / %s")
VT_STR(MINI_TIME_HMS, "%llu:%02llu:%02llu", "%llu:%02llu:%02llu")
VT_STR(MINI_TIME_HM, "%llu:%02llu", "%llu:%02llu")
